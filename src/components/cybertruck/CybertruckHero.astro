---
import Button from "../Button.astro";
import type { CybertruckHeroData } from "../../types/cybertruck";

interface Props extends CybertruckHeroData {}
const { id, title, subtitle, theme, media, actions }: Props = Astro.props;
---

<section
  id={id}
  data-theme={theme}
  class="landing-section snap-center relative flex h-[100svh] w-screen flex-col items-center overflow-hidden text-center bg-black text-white"
>
  <div class="absolute inset-0 z-0">
    {
      media.type === "video" ? (
        <video
          class="h-full w-full object-cover object-center"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          poster={media.poster}
          aria-hidden="true"
        >
          <source src={media.src} type="video/webm" />
        </video>
      ) : (
        <img
          src={media.src}
          alt={media.alt}
          class="h-full w-full object-cover object-center"
          loading="eager"
          decoding="async"
          width="1920"
          height="1080"
          fetchpriority="high"
        />
      )
    }
    <div class="absolute inset-0 bg-gradient-to-b from-black/40 via-black/20 to-black/60"></div>
  </div>

  <div class="relative z-10 flex h-full w-full flex-col">
    <header class="reveal pt-36 md:pt-40">
      <h1 class="text-5xl md:text-7xl font-black tracking-[-0.04em]">{title}</h1>
      <p class="mt-3 text-sm md:text-base tracking-wide opacity-90">{subtitle}</p>
    </header>

    <footer class="mt-auto flex flex-col items-center gap-6 pb-14 md:pb-20">
      <div class="reveal flex flex-col md:flex-row gap-3 md:gap-6" style="transition-delay:120ms">
        {actions.map((a) => <Button label={a.label} href={a.href} variant={a.variant} />)}
      </div>
      <a
        href="#cybertruck-stats"
        aria-label="Scroll to stats"
        class="reveal animate-bounce rounded-full p-2 opacity-70 hover:opacity-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white"
        style="transition-delay:250ms"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </footer>
  </div>
</section>
